{
  "name": "minimal-caretaker",
  "private": true,
  "version": "0.0.1",
  "description": "Minimal caretaker app server in demo mode: synthetic persona, scripted assistant, zero OAuth, no LLM key. Time-to-hello-world target: under 15 minutes.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kerkit/ai": "0.2.0",
    "@kerkit/core": "0.2.0",
    "@kerkit/pack-argentina": "0.2.0",
    "@kerkit/server": "0.2.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
