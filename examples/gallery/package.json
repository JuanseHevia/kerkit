{
  "name": "kerkit-gallery",
  "private": true,
  "version": "0.0.1",
  "description": "kerkit Showcase Gallery: a visual, container-runnable tour of the SDK — privacy-as-code redaction, a real tool-calling assistant, and the caretaker domain primitives. Synthetic persona, zero keys, offline by default.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p server/tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node server/dist/server.js",
    "test": "vitest run",
    "lint": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "clean": "rm -rf server/dist web/dist"
  },
  "dependencies": {
    "@kerkit/ai": "0.2.0",
    "@kerkit/core": "0.2.0",
    "@kerkit/pack-argentina": "0.2.0",
    "@kerkit/server": "0.2.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/source-serif-4": "^5.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
