{
  "name": "@kerkit/core",
  "version": "0.2.0",
  "description": "Entities, schemas, domain logic, and privacy primitives for building caretaker apps. Not a medical device; models caretaker-authored logistics data, not clinical records.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanseHevia/kerkit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "fast-check": "^4.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "caretaker",
    "caregiver",
    "health-logistics",
    "argentina",
    "obra-social",
    "privacy"
  ]
}
